# DRAFT - copy to /etc/scoutanalytics/web-export.env (root:scout, 0640) and edit.
# Non-secret: names only. The credential path is set in the systemd drop-in.
# See deploy/gcp/INTERFACE.md for every variable.

SCOUT_WEB_EXPORT=gcs
SCOUT_WEB_GCS_BUCKET=BUCKET
SCOUT_WEB_GCS_OBJECT=public/current.json
SCOUT_WEB_GCS_PREFIX=public/parts/
SCOUT_WEB_EXPORT_MIN_INTERVAL=1m
# Pointer heartbeat when the data is unchanged (INTERFACE.md 3.6); keep it at
# most half of the readers' SCOUT_WEB_STALE_AFTER (5m).
#SCOUT_WEB_EXPORT_HEARTBEAT=2m
# full (default) or delta (phase 2, INTERFACE.md 2.3)
SCOUT_WEB_EXPORT_PRICES=full
# Hosts allowed in published report links (owner decision 9 Oct 2026:
# perceptor.info). Add others only after the read-only query in INTERFACE.md 4.4.
# Links to other hosts are published as null.
SCOUT_WEB_EXPORT_URL_HOSTS=perceptor.info
